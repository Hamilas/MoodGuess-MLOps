# Development Dockerfile — lightweight, no GPU/ML dependencies
# Uses mock model backend to avoid downloading large model files
# For production use: Dockerfile (full dependencies)

FROM python:3.11-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    MLOPS_PROFILE=local \
    MLOPS_MODEL_BACKEND=mock \
    MLOPS_DEBUG=true

# Install system dependencies
RUN apt-get update && apt-get install -y \
    --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Install lightweight Python dependencies (no torch/transformers)
COPY requirements-dev-light.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-dev-light.txt

# Pre-fetch NLTK data at build time — without this, the first prediction
# request pays a 15-30s synchronous download tax (punkt/stopwords/wordnet/
# vader_lexicon/averaged_perceptron_tagger), which can trip load-balancer
# or client timeouts in a "production-grade" service.
RUN python -c "import nltk; [nltk.download(r, quiet=True) for r in ['punkt', 'stopwords', 'averaged_perceptron_tagger', 'wordnet', 'vader_lexicon']]"

# Copy application code
COPY app/ ./app/

# Create necessary directories
RUN mkdir -p /app/logs /app/tmp

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run the application
CMD ["python", "-m", "uvicorn", "app.main:app", \
    "--host", "0.0.0.0", \
    "--port", "8000", \
    "--workers", "1"]
