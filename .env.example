# SentimentOps-K8s — Environment Variables Reference
# Copy to .env and fill in your values before running locally.
# NEVER commit .env to version control.

# ─── Application Profile ────────────────────────────────────────────────────
# Options: local | development | staging | production
MLOPS_PROFILE=local

# ─── App Identity ────────────────────────────────────────────────────────────
MLOPS_APP_NAME=SentimentOps-K8s
MLOPS_APP_VERSION=1.0.0
MLOPS_DEBUG=false
MLOPS_LOG_LEVEL=INFO

# ─── Model Backend ───────────────────────────────────────────────────────────
# Options: pytorch | onnx | mock
MLOPS_MODEL_BACKEND=pytorch
MLOPS_MODEL_NAME=distilbert-base-uncased-finetuned-sst-2-english
# Optional: path to local ONNX model weights
# MLOPS_ONNX_MODEL_PATH=/app/models/sentiment.onnx

# ─── Server ──────────────────────────────────────────────────────────────────
MLOPS_HOST=0.0.0.0
MLOPS_PORT=8000
MLOPS_WORKERS=2
MLOPS_MAX_CONCURRENT_REQUESTS=100
MLOPS_REQUEST_QUEUE_SIZE=1000

# ─── CORS ────────────────────────────────────────────────────────────────────
MLOPS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5080"]

# ─── Redis (optional — disable for local mock) ───────────────────────────────
MLOPS_REDIS_ENABLED=false
MLOPS_REDIS_HOST=localhost
MLOPS_REDIS_PORT=6379
MLOPS_REDIS_DB=0
MLOPS_REDIS_PASSWORD=
MLOPS_REDIS_MAX_CONNECTIONS=20
MLOPS_REDIS_NAMESPACE=sentinelk8s
MLOPS_REDIS_PREDICTION_CACHE_TTL=3600
MLOPS_REDIS_FEATURE_CACHE_TTL=1800

# ─── Kafka (optional) ────────────────────────────────────────────────────────
MLOPS_KAFKA_ENABLED=false
MLOPS_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MLOPS_KAFKA_CONSUMER_GROUP=sentinelk8s_consumer_group
MLOPS_KAFKA_TOPIC=sentiment_requests
MLOPS_KAFKA_BATCH_SIZE=200
MLOPS_KAFKA_MAX_POLL_RECORDS=1000

# ─── MLflow (optional) ───────────────────────────────────────────────────────
MLOPS_MLFLOW_ENABLED=false
MLOPS_MLFLOW_TRACKING_URI=http://localhost:5000
MLOPS_MLFLOW_EXPERIMENT_NAME=sentinelk8s
# MLOPS_MLFLOW_S3_ARTIFACT_ROOT=s3://your-bucket/mlflow

# ─── Prometheus / Metrics ────────────────────────────────────────────────────
MLOPS_METRICS_ENABLED=true
MLOPS_METRICS_PATH=/api/v1/metrics

# ─── Distributed Tracing (OpenTelemetry) ─────────────────────────────────────
MLOPS_TRACING_ENABLED=false
MLOPS_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ─── HashiCorp Vault (optional) ──────────────────────────────────────────────
MLOPS_VAULT_ENABLED=false
MLOPS_VAULT_ADDR=http://localhost:8200
MLOPS_VAULT_TOKEN=

# ─── Anomaly / Drift Detection ───────────────────────────────────────────────
MLOPS_ANOMALY_BUFFER_ENABLED=false
MLOPS_ANOMALY_BUFFER_MAX_SIZE=10000

# ─── Cloud Provider Credentials (pick one) ───────────────────────────────────
# AWS
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-central-1
# AWS_S3_BUCKET=sentinelk8s-models

# Azure
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=sentinelk8s-models

# GCP
# GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-key.json
# GCP_PROJECT_ID=
# GCP_BUCKET=sentinelk8s-models

# ─── Security ────────────────────────────────────────────────────────────────
MLOPS_API_KEY_ENABLED=false
# MLOPS_API_KEY=your-secret-api-key-here

# ─── Development ─────────────────────────────────────────────────────────────
# Expose ports in 5080-5090 range for portfolio convention
# HOST_PORT=5080
